+    def get_3dbox_export_records(self, frame):
+        """Return per-instance GT boxes in the Waymo vehicle frame.
+
+        Waymo ``laser_labels`` are expressed in the current vehicle/ego
+        frame.  Export corners in that frame so they use the same geometry as
+        ``get_3dbox_image`` and can be paired with
+        ``box_reference_to_camera`` by the common preview exporter.
+        """
+        color_table = MotionDataset.default_3dbox_color_table
+        if self._3dbox_image_settings is not None:
+            color_table = self._3dbox_image_settings.get(
+                "color_table",
+                color_table,
+            )
+        allowed_types = set(color_table)
+        corner_template = np.asarray(
+            MotionDataset.default_3dbox_corner_template,
+            dtype=np.float32,
+        ).T
+        records = []
+
+        for label in frame.laser_labels:
+            label_type = int(label.type)
+            class_name = next(
+                (
+                    name
+                    for name, type_id in MotionDataset.box_type_dict.items()
+                    if type_id == label_type
+                ),
+                None,
+            )
+            if class_name is None or class_name not in allowed_types:
+                continue
+
+            box = label.box
+            box_values = np.asarray(
+                [
+                    box.center_x,
+                    box.center_y,
+                    box.center_z,
+                    box.length,
+                    box.width,
+                    box.height,
+                    box.heading,
+                ],
+                dtype=np.float32,
+            )
+            if not np.isfinite(box_values).all():
+                continue
+
+            ego_from_box = dwm.datasets.common.get_transform(
+                transforms3d.euler.euler2quat(
+                    0,
+                    0,
+                    float(box.heading),
+                ).tolist(),
+                [box.center_x, box.center_y, box.center_z],
+            ).astype(np.float32)
+            box_scale = np.diag(
+                [box.length, box.width, box.height, 1.0]
+            ).astype(np.float32)
+            corners_ref = (
+                ego_from_box @ box_scale @ corner_template
+            )[:3].T.astype(np.float32, copy=False)
+
+            records.append(
+                {
+                    "gt_id": str(label.id),
+                    "class_name": class_name,
+                    "corners_ref": corners_ref.tolist(),
+                }
+            )
+        return records
+
