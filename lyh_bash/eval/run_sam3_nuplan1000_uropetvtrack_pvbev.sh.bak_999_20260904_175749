def load_jsonl(path):
    result = []
    with path.open("r", encoding="utf-8") as f:
        for line in f:
            if line.strip():
                result.append(json.loads(line))
    return result


def resolve_path(value, manifest):
    p = Path(str(value))
    if not p.is_absolute():
        p = manifest.parent / p
    return p.resolve()


# ============================================================
# Target manifests
# ============================================================

urope = load_jsonl(UROPE_MANIFEST)
pvbev = load_jsonl(PVBEV_MANIFEST)

print()
